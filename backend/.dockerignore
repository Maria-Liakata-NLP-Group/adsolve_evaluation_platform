evaluation_bundles/
legacy_data/

# Test and dev artifacts
tests/
.pytest_cache/

# Test coverage
.coverage
htmlcov/
coverage.xml

# Git and IDE
.git/
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
