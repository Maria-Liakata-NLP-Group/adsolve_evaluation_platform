# Local development environment — run: source backend/.env
# DATABASE_URL is not needed here; the backend defaults to localhost:5432/adsolve
# For Docker, DATABASE_URL is set in docker-compose.yml

# Optional: comma-separated allowed origins for CORS
export ALLOWED_ORIGINS=http://localhost:5173

# Admin token for write operations (POST/PUT/DELETE on config entities)
export ADMIN_TOKEN=change-me-to-a-strong-random-secret
