# Local development environment — run: source backend/.env
# DATABASE_URL is not needed here; the backend defaults to localhost:5432/adsolve
# For Docker, DATABASE_URL is set in docker-compose.yml

# Optional: comma-separated allowed origins for CORS
export ALLOWED_ORIGINS=http://localhost:5173

# Admin token for write operations (POST/PUT/DELETE on config entities)
export ADMIN_TOKEN=change-me-to-a-strong-random-secret

# ── Metric calculation service (adsolve_utilities/evaluation_api) ──────────────
# All three are required to run calculations. If any is unset, the evaluation
# routes return 503 rather than accepting runs the platform cannot dispatch.

# Base URL of the metric calculation API.
export METRIC_API_URL=http://localhost:8000

# Its X-Api-Token shared secret — the METRIC_API_TOKEN set in that repo's .env.
# Never sent to the browser; only this backend talks to the metric API.
export METRIC_API_TOKEN=change-me-to-match-the-metric-api

# This platform's base URL *as reachable from the metric API host*. Results are
# POSTed back to <this>/api/evaluations/{job_id}/callback.
export PLATFORM_CALLBACK_URL=http://localhost:8005
